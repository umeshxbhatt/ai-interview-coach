{
  "name": "interview-ai-monorepo",
  "version": "1.0.0",
  "description": "Production-Ready AI-powered Interview Preparation SaaS",
  "scripts": {
    "bootstrap": "npm run install:backend && npm run install:frontend",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install --legacy-peer-deps",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:python": "cd python-service && venv/bin/activate && uvicorn main:app --reload --port 8000",
    "dev": "concurrently -n \"BACKEND,FRONTEND,PYTHON\" -c \"blue,green,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:python\"",
    "check:backend": "cd backend && npm run check",
    "check:frontend": "cd frontend && npm run check",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:backend && npm run build:frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
