# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/interview_ai?retryWrites=true&w=majority

# JWT Configurations (Keys should be cryptographically secure random values)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_here_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_here_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Services
GEMINI_API_KEY=your_google_gemini_api_key_here

# Python Semantic Evaluation Microservice URL
PYTHON_SERVICE_URL=http://localhost:8000
